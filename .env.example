APP_NAME="PingPong Mania"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pingpong_mania
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="PingPong Mania"

# Raspberry Pi address reachable from the Laravel server on the same LAN.
# Example: http://192.168.1.50:5000
RASPBERRY_PI_URL=
# Generate a long random secret and set the SAME value on Raspberry Pi.
RASPBERRY_PI_TOKEN=
RASPBERRY_PI_TIMEOUT=3
